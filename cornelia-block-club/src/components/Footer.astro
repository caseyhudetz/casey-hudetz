---
const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer class="bg-primary text-white mt-auto">
  <div class="container-wide py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- About -->
      <div>
        <h3 class="font-display text-xl mb-4 text-white">Cornelia Ave</h3>
        <p class="text-primary-light text-sm leading-relaxed">
          A community of neighbors on Cornelia Avenue between Elaine Place and Broadway in Chicago's East Lakeview neighborhood.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="font-display text-lg mb-4 text-white">Quick Links</h4>
        <ul class="space-y-2">
          <li>
            <a href={base + "resources"} class="text-primary-light hover:text-white text-sm transition-colors">
              Local Resources
            </a>
          </li>
          <li>
            <a href={base + "block-party"} class="text-primary-light hover:text-white text-sm transition-colors">
              Block Party Info
            </a>
          </li>
          <li>
            <a href={base + "get-involved"} class="text-primary-light hover:text-white text-sm transition-colors">
              Get Involved
            </a>
          </li>
          <li>
            <a href={base + "contact"} class="text-primary-light hover:text-white text-sm transition-colors">
              Contact Us
            </a>
          </li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="font-display text-lg mb-4 text-white">Location</h4>
        <address class="text-primary-light text-sm not-italic leading-relaxed">
          Cornelia Avenue<br />
          Between Elaine Place & Broadway<br />
          Chicago, IL 60657<br />
          East Lakeview
        </address>
      </div>
    </div>

    <div class="border-t border-primary-light/30 mt-8 pt-8 text-center">
      <p class="text-primary-light text-sm">
        &copy; {currentYear} Cornelia Ave Block Club. Made with care for our neighbors.
      </p>
    </div>
  </div>
</footer>
